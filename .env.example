# Primary OpenAI-compatible local settings. LMSTUDIO_* variables still work
# as legacy fallback if the SMDEBATE_* values are unset.
SMDEBATE_BASE_URL=http://localhost:11434/v1
SMDEBATE_API_KEY=ollama
SMDEBATE_MODEL=qwen3:8b
SMDEBATE_MODEL_REF=ollama:qwen3:8b
SMDEBATE_MODEL_FAMILY=qwen3
SMDEBATE_PARAMETER_SIZE=8B
SMDEBATE_QUANTIZATION=ollama-default
SMDEBATE_REASONING_MODE=no_think
SMDEBATE_CONTEXT_LENGTH=4096
SMDEBATE_TEMPERATURE=0.7
SMDEBATE_TOP_P=0.8
SMDEBATE_AGENT_COUNT=3
SMDEBATE_ROUNDS=2
